rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own() { return signed() && resource.data.ownerUid == request.auth.uid; }
    function text(v, max) { return v is string && v.size() <= max; }
    function categories(v) {
      return v is list && v.size() >= 1 && v.size() <= 8
        && v.toSet().size() == v.size()
        && v.hasOnly(['waste','container','sewer','ditch','organic','metabolic','chemical','other']);
    }
    function validIdentity(d, id) {
      return d.keys().hasOnly(['ownerUid','reportId','name','email','emailVerified','receivedAt','consent'])
        && d.ownerUid == request.auth.uid && d.reportId == id
        && text(d.name,120) && d.name.size() > 0
        && text(d.email,254) && d.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && d.emailVerified == false && d.receivedAt == request.time
        && d.consent.keys().hasOnly(['cloudStorage','contextConfirmed','version','acceptedAt'])
        && d.consent.cloudStorage == true && d.consent.contextConfirmed == true
        && d.consent.version == 'waind-firebase-dev-1' && text(d.consent.acceptedAt,40);
    }
    function validReport(d,id) {
      return d.keys().hasOnly(['schemaVersion','id','ownerUid','receivedAt','recordedAt','occurrence',
        'intensity','categories','otherDescription','location','weather','photoProvided',
        'noVisibleSource','visibleTags','observation','evidenceType','verificationStatus','causeProven','ai','appVersion'])
        && d.schemaVersion == 3 && d.id == id && d.ownerUid == request.auth.uid
        && d.receivedAt == request.time && text(d.recordedAt,40)
        && d.intensity is int && d.intensity >= 1 && d.intensity <= 5
        && categories(d.categories) && text(d.otherDescription,240)
        && (!d.categories.hasAny(['other']) || d.otherDescription.size() > 0)
        && d.location.keys().hasOnly(['latitude','longitude','source','accuracyMeters'])
        && d.location.latitude is number && d.location.latitude >= -85 && d.location.latitude <= 85
        && d.location.longitude is number && d.location.longitude >= -180 && d.location.longitude <= 180
        && d.location.source in ['device-gps','manual-map','manual-coordinates']
        && (d.location.accuracyMeters == null || (d.location.accuracyMeters is number && d.location.accuracyMeters >= 0))
        && d.occurrence.keys().hasOnly(['kind','occurredAt','timezone','approximate'])
        && d.occurrence.kind in ['current','past'] && text(d.occurrence.occurredAt,40)
        && d.occurrence.timezone == 'America/Sao_Paulo'
        && d.occurrence.approximate == (d.occurrence.kind == 'past')
        && (d.weather == null || (d.weather.keys().hasOnly(['source','temperatureC','relativeHumidityPercent','windSpeedKmh','observedAt','timezone','basis'])
          && d.weather.source == 'Open-Meteo' && d.weather.temperatureC is number
          && d.weather.relativeHumidityPercent is number && d.weather.relativeHumidityPercent >= 0 && d.weather.relativeHumidityPercent <= 100
          && d.weather.windSpeedKmh is number && d.weather.windSpeedKmh >= 0
          && text(d.weather.observedAt,40) && d.weather.timezone == 'America/Sao_Paulo'
          && d.weather.basis in ['study-area','device-region','manual-region']))
        && d.visibleTags is list && d.visibleTags.size() <= 8
        && d.visibleTags.toSet().size() == d.visibleTags.size()
        && d.visibleTags.hasOnly(['Lixo acumulado','Contentor próximo','Bueiro / ralo','Água parada','Vala aberta','Restos de alimentos','Animais por perto','Nada aparente'])
        && d.noVisibleSource is bool && d.photoProvided is bool && text(d.observation,400)
        && d.evidenceType == 'citizen-perception' && d.verificationStatus == 'isolated-unconfirmed'
        && d.causeProven == false && d.appVersion == '0.5.0-dev'
        && d.ai.keys().hasOnly(['computerVisionExecuted','predictionExecuted'])
        && d.ai.computerVisionExecuted == false && d.ai.predictionExecuted == false;
    }
    match /relatos/{id} {
      allow get: if signed() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow list: if own() && request.query.limit <= 100;
      allow create: if signed() && validReport(request.resource.data,id)
        && getAfter(/databases/$(database)/documents/participantes/$(id)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/participantes/$(id)).data.reportId == id;
      allow update, delete: if false;
    }
    match /participantes/{id} {
      allow get: if own();
      allow list: if own() && request.query.limit <= 100;
      allow create: if signed() && validIdentity(request.resource.data,id)
        && getAfter(/databases/$(database)/documents/relatos/$(id)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
